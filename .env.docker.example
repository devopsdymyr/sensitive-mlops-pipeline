# Copy to .env and adjust before `docker compose up` (never commit real .env).

# --- VM public access (GitHub Actions secrets, laptop browser, curl) ---
# Replace after reprovision: curl -fsS https://api.ipify.org
PUBLIC_HOST=34.100.137.211
# With default ports below, URLs are:
#   API health:     http://PUBLIC_HOST:8080/healthz
#   MLflow UI:      http://PUBLIC_HOST:5000
#   Feast UI:       http://PUBLIC_HOST:8888
#   MinIO API (S3): http://PUBLIC_HOST:9000
#   MinIO console:  http://PUBLIC_HOST:9001
# Open these TCP ports in your cloud firewall / security group.
# Smoke test:  bash scripts/test_public_endpoints.sh
# Copy this file to .env before `docker compose up` so PUBLIC_HOST is applied to MinIO public URLs.

# Postgres (MLflow metadata)
POSTGRES_PASSWORD=mlflow_dev_change_me

# MinIO (S3-compatible: MLflow artifacts + optional DVC remote bucket dvc-cache)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
# MinIO public URLs are set in docker-compose.yml from PUBLIC_HOST + MINIO_*_PORT (no extra keys needed).

# Optional: dedicated S3 access key + secret (MinIO service account) for MLflow / app / train / DVC.
# If set, compose uses these instead of MINIO_ROOT_* for boto3. Mint keys after `docker compose up -d minio`:
#   bash scripts/minio_create_s3_credentials.sh
#   make minio-keys
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# Published ports (host)
# If bind fails: 5000 is often taken (e.g. macOS AirPlay); 8080 by other dev servers — pick free ports.
APP_PORT=8080
MLFLOW_PORT=5000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Feast UI (host)
FEAST_UI_PORT=8888

# Train: set 0 to skip registering MinIO as default DVC remote (local .dvc/cache volume only)
CONFIGURE_DVC_MINIO_REMOTE=1
